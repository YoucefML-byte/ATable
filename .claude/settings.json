{
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test*)",
      "Bash(pnpm check)",
      "Bash(pnpm e2e*)",
      "Bash(pnpm db:start)",
      "Bash(pnpm db:stop)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:test)",
      "Bash(pnpm db:types)",
      "Bash(pnpm db:lint)",
      "Bash(pnpm demo:qr*)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec supabase status*)",
      "Bash(pnpm exec supabase migration new *)",
      "Bash(pnpm exec supabase migration list*)",
      "Bash(pnpm exec supabase test db*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase status*)",
      "Bash(supabase db reset*)",
      "Bash(supabase test db*)",
      "Bash(supabase gen types*)",
      "Bash(supabase migration new*)",
      "Bash(supabase migration list*)",
      "Bash(supabase db lint*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(node --version)",
      "Bash(docker ps*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh repo create*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm run *)",
      "Bash(npx *)",
      "Bash(bunx *)",
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(supabase secrets*)",
      "Bash(vercel *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm admin:create*)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.production.*)",
      "Read(./**/*.age)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard origin*)",
      "Bash(supabase db push --db-url*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(pnpm exec supabase link*)",
      "Bash(npx supabase link*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs" }]
      }
    ]
  }
}
