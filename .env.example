# Copy to .env.local for local development (never commit .env.local).
# Local values are printed by `pnpm db:start` (supabase status).

# Supabase project URL and publishable key (public)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only, bypasses RLS) — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Platform domains (production: atable.fr, pro.atable.fr, console.atable.fr)
PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_PRO_HOST=pro.localhost:3000
PLATFORM_CONSOLE_HOST=console.localhost:3000
# Scheme used to build absolute links (https in production)
PUBLIC_SCHEME=http
# Fictitious, non-routable domain of the staff technical users
STAFF_EMAIL_DOMAIN=staff.atable.invalid

# Optional: public CDN base for images (defaults to the Supabase URL)
STORAGE_PUBLIC_URL=
# Authenticates calls of the scheduled jobs (Vercel cron)
CRON_SECRET=
# Vercel API (custom domains), token limited to the project
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Error tracking (EU region)
SENTRY_DSN=
# "true" to send the CSP in Report-Only mode
CSP_REPORT_ONLY=false
